
# orbitle.futile.studio
#
# The pre-rename orbit.futile.studio was listed here as well, to keep that link
# alive across the rename. Its DNS record was moved to the new name rather than
# duplicated, so the old hostname no longer resolves and listing it was dead
# config. install.sh strips a block under either name, so re-running it replaces
# the two-hostname version with this one.
http://orbitle.futile.studio {
	root * /opt/apps/Orbitle/dist
	encode zstd gzip

	# Astro hashes the bundle filenames, so the two halves cache differently.
	# index.html must revalidate or a deploy serves yesterday's page against
	# today's assets; the hashed files can never go stale, since a change to one
	# changes its name. The second matcher excludes /_astro/* rather than
	# relying on directive order: both header directives match every request
	# otherwise, and the last one written would win.
	@hashed path /_astro/*
	@page not path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @page Cache-Control "no-cache"

	file_server
}
