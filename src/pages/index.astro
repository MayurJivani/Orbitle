---
import Layout from '../layouts/Layout.astro'
import { DIAL, FRAMES, MODES, QUESTIONS, ROUNDS_PER_DAY, rng } from '../../shared/orbit.js'

// A fixed starfield, seeded so every build puts the stars in the same place.
// It sits outside the ring layer, so zooming the dial does not zoom the sky.
const rand = rng(0x5e4a11)
const stars = Array.from({ length: 150 }, () => {
	const r = Math.sqrt(rand()) * 700
	const a = rand() * Math.PI * 2
	return {
		cx: DIAL.cx + Math.cos(a) * r,
		cy: DIAL.cy + Math.sin(a) * r,
		r: 0.5 + rand() ** 3 * 1.9,
		// Dim: the sky is a backdrop, not part of the instrument.
		o: (0.1 + rand() * 0.4).toFixed(2),
	}
})
---

<Layout title="Orbitle: where does it orbit?">
	<main>
		<header class="plate top">
			<div class="brand">
				<h1>Orbitle</h1>
				<p class="tag" id="day">loading</p>
			</div>
			<div class="difficulty">
				<span class="tag">difficulty</span>
				<div class="levels" id="modes">
					{MODES.map((m) => (
						<button class="level" data-mode={m.id} title={m.blurb}>{m.name}</button>
					))}
				</div>
			</div>
		</header>

		<!-- The question comes before the dial, so a phone shows what is being
		     asked without anybody scrolling for it. -->
		<section class="plate prompt">
			<div class="prompt-head">
				<p class="tag" id="round">round 1 of {ROUNDS_PER_DAY}</p>
				<p class="tag" id="mode-note">—</p>
			</div>
			<h2 id="subject">—</h2>
			<p class="primary"><span id="primary">—</span><span class="chip" id="category"></span></p>
			<p class="question" id="question">—</p>
		</section>

		<section class="stage">
			<svg id="dial" viewBox="0 0 1000 1000" role="presentation">
				<defs>
					<radialGradient id="hubGlow">
						<stop offset="0%" stop-color="rgba(188, 214, 255, 0.5)" />
						<stop offset="55%" stop-color="rgba(120, 160, 240, 0.14)" />
						<stop offset="100%" stop-color="rgba(120, 160, 240, 0)" />
					</radialGradient>
				</defs>

				<g class="stars">
					{stars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} opacity={s.o} />)}
				</g>

				<!-- Rings are drawn by the client: which ones exist depends on the
				     round's dial and on how far the player has zoomed in. -->
				<g id="rings"></g>

				<!-- The body at the centre, named per round. -->
				<circle class="hub-glow" cx={DIAL.cx} cy={DIAL.cy} r={DIAL.inner + 26} />
				<circle class="hub" cx={DIAL.cx} cy={DIAL.cy} r={DIAL.inner - 16} />
				<text class="hub-label" id="hub-label" x={DIAL.cx} y={DIAL.cy + 5}>—</text>

				<!-- Revealed after an answer is locked in. -->
				<circle class="answer off" id="answer" cx={DIAL.cx} cy={DIAL.cy} r="0" />

				<!-- The answer being placed. Angle is decoration; only radius is read. -->
				<circle class="guess-ring" id="guess-ring" cx={DIAL.cx} cy={DIAL.cy} r={DIAL.inner} />
				<line class="arm" id="arm" x1={DIAL.cx} y1={DIAL.cy} x2={DIAL.cx + DIAL.inner} y2={DIAL.cy} />
				<g
					id="handle"
					role="slider"
					tabindex="0"
					aria-label="Your answer"
					aria-valuemin="0"
					aria-valuemax="1000"
					aria-valuenow="500"
					aria-valuetext="—"
				>
					<circle class="handle-hit" cx={DIAL.cx + DIAL.inner} cy={DIAL.cy} r="34" />
					<circle class="handle-halo" cx={DIAL.cx + DIAL.inner} cy={DIAL.cy} r="22" />
					<circle class="handle" cx={DIAL.cx + DIAL.inner} cy={DIAL.cy} r="12" />
				</g>
			</svg>

			<div class="under">
				<div class="zoom">
					<button class="step" id="zoom-out" aria-label="Zoom out">−</button>
					<b id="zoom-level">1x</b>
					<button class="step" id="zoom-in" aria-label="Zoom in">+</button>
				</div>
				<p class="window" id="window">—</p>
			</div>
			<p class="tag hint">
				Drag the marker, pinch or use the zoom buttons, arrow keys to nudge. Only
				the distance from the centre counts.
			</p>
		</section>

		<aside class="plate panel">
			<ul class="modes" id="questions">
				{QUESTIONS.map((q) => <li data-question={q.id}>{q.name}</li>)}
			</ul>
			<ul class="frames" id="frames">
				{FRAMES.map((f) => (
					<li data-frame={f.id}>
						<b>{f.name}</b>
						<span class="tag">{f.span}</span>
					</li>
				))}
			</ul>

			<div id="verdict" hidden>
				<p class="points"><b id="points">0</b><span class="tag" id="grade"></span></p>
				<div class="row">
					<span class="tag">actual</span>
					<b id="actual">—</b>
				</div>
				<div class="row">
					<span class="tag">out by</span>
					<b id="delta">—</b>
				</div>

				<!-- What the thing actually is, and whose orbit it sits in. -->
				<dl class="facts" id="facts"></dl>
				<p class="note" id="note"></p>
				<p class="host" id="host"></p>
			</div>

			<div id="summary" hidden>
				<p class="total"><b id="total">0</b><span class="tag">out of {ROUNDS_PER_DAY * 100}</span></p>
				<p class="runs" id="runs"></p>
				<p class="tag" id="tomorrow">A new five tomorrow.</p>
			</div>
		</aside>

		<!-- Readout and the one button that matters, kept together: a bar across the
		     bottom of a phone, a block in the column on a desktop. -->
		<div class="commit plate">
			<div class="readout">
				<span class="tag" id="guess-label">your answer</span>
				<b id="readout">—</b>
			</div>
			<div class="actions">
				<button class="action" id="place">Place it</button>
				<button class="action" id="next" hidden>Next</button>
				<button class="action" id="share" hidden>Copy result</button>
			</div>
		</div>
	</main>
</Layout>

<script>
	import '../scripts/client.js'
</script>

<!-- The ring layer is drawn by the client, so its elements carry no scoping
     attribute and these rules have to be global. Scoped, they match nothing,
     and the dial renders as black circles with no stroke. -->
<style is:global>
	#rings .decade circle,
	#rings .landmark circle { fill: none; }

	/* Every label sits over rings, stars and sometimes the marker, so it carries
	   its own dark outline. Without this the type is legible on the ground and
	   mud everywhere else. */
	#rings text {
		text-anchor: middle;
		paint-order: stroke;
		stroke: #03050a;
		stroke-width: 5px;
		stroke-linejoin: round;
	}

	#rings .decade circle { stroke: var(--line); stroke-width: 2; }
	#rings .decade text {
		fill: var(--faint);
		font-size: 15px;
		letter-spacing: 0.06em;
	}

	#rings .landmark circle { stroke: var(--line-strong); stroke-width: 2.5; stroke-dasharray: 7 6; }
	#rings .landmark text {
		fill: var(--cyan-soft);
		font-size: 15px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	/* SVG type is in user units, so on a phone the whole dial is scaled to about
	   a third and 15px renders at 5. Everything in the dial goes up with it. */
	@media (max-width: 860px) {
		#rings .decade text, #rings .landmark text { font-size: 30px; }
		#rings text { stroke-width: 9px; }
		#rings .decade circle { stroke-width: 3; }
		#rings .landmark circle { stroke-width: 4; stroke-dasharray: 12 10; }
	}
</style>

<style>
	main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 360px;
		grid-template-areas:
			'top    top'
			'stage  prompt'
			'stage  commit'
			'stage  panel';
		grid-template-rows: auto auto auto 1fr;
		gap: 14px;
		align-items: start;
		max-width: 1180px;
		margin: 0 auto;
		padding: 16px;
	}

	.top {
		grid-area: top;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	h1 { font-size: 32px; line-height: 1; letter-spacing: 0.08em; }

	.difficulty { display: flex; align-items: center; gap: 10px; }
	.levels { display: flex; gap: 6px; }
	.level {
		border: 1px solid var(--line);
		border-radius: 3px;
		padding: 7px 12px;
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.level:hover { border-color: var(--line-strong); color: var(--white); }
	.level.is-on { border-color: var(--amber); color: var(--amber); }
	.level[disabled] { cursor: default; opacity: 0.55; }
	.level[disabled]:hover { border-color: var(--line); color: var(--muted); }

	.prompt { grid-area: prompt; }
	.prompt-head { display: flex; justify-content: space-between; gap: 10px; }
	h2 { font-size: 27px; line-height: 1.1; margin: 8px 0 2px; }
	.primary { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; color: var(--muted); }
	.chip {
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		padding: 1px 8px;
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--hub);
		white-space: nowrap;
	}
	.question { margin: 0; color: var(--white); font-size: 14px; }

	.stage { grid-area: stage; }

	#dial {
		display: block;
		width: 100%;
		max-height: 68vh;
		touch-action: none;
		cursor: crosshair;
	}

	.stars circle { fill: var(--star); }

	/* SVG has no `hidden`, so this is how anything in the dial goes away. */
	.off { display: none; }

	.answer, .guess-ring { fill: none; }

	.hub-glow { fill: url(#hubGlow); opacity: 0.45; }
	.hub { fill: #080d18; stroke: rgba(190, 212, 255, 0.35); }
	.hub-label {
		fill: var(--hub);
		font-size: 15px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-anchor: middle;
	}

	.guess-ring { stroke: var(--amber); stroke-width: 3; stroke-dasharray: 4 8; }
	.arm { stroke: var(--amber); stroke-width: 2; opacity: 0.55; }
	.handle { fill: var(--amber); }
	.handle-halo { fill: rgba(255, 193, 77, 0.16); }
	.handle-hit { fill: transparent; }
	#handle { cursor: grab; }
	#handle:focus-visible .handle-halo { fill: rgba(255, 193, 77, 0.4); }

	.answer { stroke: var(--green); stroke-width: 3.5; }

	.under {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 8px;
	}
	.zoom { display: flex; align-items: center; gap: 8px; }
	.zoom b { font-variant-numeric: tabular-nums; min-width: 28px; text-align: center; }
	.step {
		border: 1px solid var(--line-strong);
		border-radius: 4px;
		min-width: 40px;
		min-height: 36px;
		font-size: 17px;
		color: var(--white);
	}
	.step:hover { background: var(--surface-lt); }
	.step[disabled] { opacity: 0.35; cursor: default; }
	.window { margin: 0; text-align: right; font-size: 12px; letter-spacing: 0.06em; color: var(--white); }

	.hint { margin: 8px 0 0; text-align: center; }

	.panel { grid-area: panel; }

	.modes { display: flex; gap: 6px; list-style: none; margin: 0 0 10px; padding: 0; }
	.modes li {
		flex: 1;
		border: 1px solid var(--line);
		border-radius: 3px;
		padding: 5px 6px;
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-align: center;
		color: var(--faint);
	}
	.modes li.is-on { border-color: var(--amber); color: var(--amber); }

	.frames { list-style: none; margin: 0; padding: 0; }
	.frames li {
		display: flex;
		flex-direction: column;
		border-left: 2px solid var(--line);
		padding: 2px 0 2px 10px;
		color: var(--faint);
	}
	.frames li b { font-weight: 500; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }
	.frames li.is-on { border-left-color: var(--amber); color: var(--white); }
	.frames li.is-on .tag { color: var(--muted); }

	.row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
		border-top: 1px solid var(--line);
		padding: 7px 0;
	}
	.row b { font-weight: 500; font-variant-numeric: tabular-nums; }

	/* The fact sheet: label on the left, value on the right, one line each. */
	.facts {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 2px 12px;
		margin: 12px 0 0;
		border-top: 1px solid var(--line);
		padding-top: 10px;
	}
	.facts dt {
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--faint);
		align-self: baseline;
	}
	.facts dd {
		margin: 0;
		text-align: right;
		font-variant-numeric: tabular-nums;
		color: var(--white);
	}

	.note { color: var(--hub); border-left: 2px solid var(--line-strong); padding-left: 10px; margin: 12px 0 0; }
	.host { color: var(--muted); font-size: 12px; margin: 10px 0 0; }

	.points, .total { display: flex; align-items: baseline; gap: 10px; margin: 2px 0 8px; }
	.points b, .total b { font-family: var(--display); font-size: 42px; line-height: 1; }

	.runs { font-size: 20px; letter-spacing: 0.1em; margin: 10px 0 2px; }

	.commit {
		grid-area: commit;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.readout { display: flex; flex-direction: column; }
	.readout b { font-size: 17px; font-variant-numeric: tabular-nums; }
	.actions { display: flex; gap: 8px; }

	.action {
		border: 1px solid var(--amber);
		color: var(--amber);
		border-radius: 4px;
		padding: 12px 18px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-size: 11px;
		min-height: 44px;
	}
	.action:hover { background: rgba(255, 193, 77, 0.12); }
	.action[disabled] { opacity: 0.4; cursor: default; border-color: var(--faint); color: var(--faint); }

	@media (max-width: 860px) {
		main {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'top' 'prompt' 'stage' 'panel';
			gap: 10px;
			padding: 10px 10px 92px;
		}

		h1 { font-size: 26px; }
		.top { gap: 10px; }
		.difficulty { width: 100%; justify-content: space-between; }
		.levels { flex: 1; justify-content: flex-end; }
		.level { flex: 1; max-width: 100px; min-height: 44px; }

		h2 { font-size: 24px; }
		#dial { max-height: none; }

		/* Twice the touch target on the marker: 34 user units is about 12 real
		   pixels once the dial is scaled to a phone, which is unhittable. */
		.handle-hit { r: 80px; }
		.handle { r: 18px; }
		.handle-halo { r: 34px; }
		.hub-label { font-size: 30px; }

		.step { min-width: 56px; min-height: 48px; font-size: 20px; }
		.zoom { gap: 12px; }
		.window { font-size: 11px; }
		.hint { display: none; }

		/* The readout and the button follow the thumb instead of the scroll. */
		.commit {
			position: fixed;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 5;
			border-radius: 0;
			border-left: 0;
			border-right: 0;
			border-bottom: 0;
			padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
			background: color-mix(in srgb, #070c18 92%, transparent);
		}
		.readout b { font-size: 20px; }
		.action { flex: 0 0 auto; padding: 12px 22px; }
	}
</style>
