---
/**
 * Deep space: near-black ground, two faint nebula washes, and the starfield
 * drawn into the dial itself. No grid and no drafting-table surfaces, since the
 * subject is the sky rather than a plan of it. The type pairing stays the
 * studio's (condensed display over a mono body), which reads as mission
 * telemetry without any help from the palette.
 */
interface Props { title: string }
const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta
			name="description"
			content="A daily guessing game about orbits. Five things a day on three dials: near Earth, the Earth system, and the solar system out to Voyager 1."
		/>
		<meta name="theme-color" content="#03050a" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #03050a;
		--surface: rgba(16, 24, 42, 0.62);
		--surface-lt: rgba(34, 48, 78, 0.7);
		/* The rings and their labels are the instrument, so they are the brightest
		   thing on the page after the marker. The first pass had them at a tenth
		   of an alpha over near-black and the dial was unreadable: the hub glow
		   was the only thing anybody could see. */
		--line: rgba(198, 219, 255, 0.3);
		--line-strong: rgba(198, 219, 255, 0.58);
		--star: #dfe9ff;
		--cyan-soft: #cfe0ff;
		--white: #eaf0fb;
		/* Both greys are set by contrast, not by taste: the small tracked-out
		   labels are 10-11px, so they need 4.5:1, and they have to clear it
		   against the lightest part of the nebula wash and not just the
		   near-black ground. A darker --faint looked better and failed. */
		--muted: #c3cfe4;
		--faint: #a2b1cb;
		--amber: #ffc14d;
		--green: #5ce39b;
		--hub: #bcd6ff;

		--display: 'Big Shoulders Display', 'Arial Narrow', sans-serif;
		--mono: 'JetBrains Mono', 'Space Mono', 'Courier New', monospace;
	}

	* { box-sizing: border-box; }

	html, body { margin: 0; min-height: 100%; }

	body {
		/* Two cold nebula washes over near-black. No repeating pattern: a tiled
		   background reads as wallpaper, and space does not tile. */
		background:
			radial-gradient(1100px 780px at 72% -12%, rgba(64, 98, 190, 0.2), transparent 62%),
			radial-gradient(900px 700px at 6% 112%, rgba(120, 66, 170, 0.16), transparent 60%),
			var(--bg);
		background-attachment: fixed;
		color: var(--white);
		font-family: var(--mono);
		font-size: 13px;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		-webkit-tap-highlight-color: transparent;
	}

	h1, h2, .display {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		margin: 0;
	}

	.tag {
		font-size: 10px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.plate {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 3px;
		padding: 12px 16px;
		backdrop-filter: blur(10px);
	}

	button {
		font: inherit;
		color: inherit;
		background: none;
		border: none;
		cursor: pointer;
	}

	:focus-visible {
		outline: 2px solid var(--amber);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		* { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
	}
</style>
